{
  "exe": "/opt/maya/build-hip/maya",
  "args": [
    "--glm-pack", "/data/pack",
    "--max-context", "524288",
    "--expert-cache", "auto",
    "--prefill", "16384",
    "--kv-streaming", "on",
    "--kv", "int8",
    "--expert-profile", "/opt/maya/data/expert-profile-glm.bin"
  ],
  "cwd": "/opt/maya",
  "tokenizer": "/data/pack/tokenizer",
  "model_name": "glm-5.3-flash-iq2s-derisked",
  "gpu": [
    0,
    1
  ],
  "sampling": {
    "temperature": 1.0,
    "top_p": 0.95
  },
  "reasoning_effort": "max",
  "lib_dirs": [
    "/opt/rocm-7.2.1/lib"
  ],
  "port": 8080,
  "backend": "hip",
  "host": "0.0.0.0",
  "env": {
    "MAYA_GLM_RAM_GB": "36",
    "MAYA_GLM_RESERVE_MB": "1200",
    "MAYA_GLM_RESERVE_LATER_MB": "650",
    "MAYA_GLM_RAM_HEADROOM_GB": "16",
    "MAYA_GLM_PREFILL_SUB": "1024",
    "MAYA_GLM_PREFILL_MB": "6144",
    "MAYA_GLM_MLA_ATTN2": "h64lvc",
    "MAYA_GLM_DSA_SCORE2": "rl2b4",
    "MAYA_GLM_SLOTS": "4",
    "MAYA_GLM_SLOT_GB": "16",
    "MAYA_GLM_SLOT_KEEP": "1",
    "MAYA_HIPBLASLT_TUNING": "/opt/maya/tools/hip/gfx1100-glm-hipblaslt-100202.txt:/opt/maya/tools/hip/gfx1100-glm-hipblaslt-100401.txt:/opt/maya/tools/hip/gfx1100-glm-hipblaslt-100500.txt"
  },
  "vision": {
    "exe": "/opt/maya/build-vision/bin/maya-vision",
    "mmproj": "/data/vision/mmproj-GLM-5.3-Flash-F16.gguf",
    "model": "/data/vision/GLM-5.3-Flash-vocab.gguf",
    "gpu": true
  },
  "log": "/opt/maya/maya-glm53f-iq2s-derisked-hip.log",
  "installer": {
    "family": "glm",
    "quant": "Maya-M-Derisked",
    "gguf": "GLM-5.3-Flash-Maya-M-Derisked-IQ2_S (peasantsmith, IQ2_S, packed with tools/iq_pack.py from the per-file read-only model binds)",
    "gguf_dir": "/data",
    "draft": "mtp",
    "written": "2026-11-05 (llm-ops; the entrypoint copies this config into /data/config at every start)"
  }
}
