    "--pack", "/data/pack/maya-ds4",
    "--max-context", "524288",
    "--tp", "2",
    "--ssd-cache", "36",
    "--reserve-mib", "1664",
    "--suffix-draft", "0"
  ],
  "cwd": "/opt/maya",
  "tokenizer": "/data/pack/maya-ds4/tokenizer",
